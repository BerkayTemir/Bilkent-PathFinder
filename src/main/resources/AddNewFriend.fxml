<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AddNewFriendController"
            prefWidth="419" prefHeight="336"
            style="-fx-background-color: #F1F5F9;">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="66"
              style="-fx-background-color: white; -fx-padding: 0 18; -fx-border-color: transparent transparent #DCE4EE transparent;">
            <Label text="Bilkent PathFinder"
                   style="-fx-text-fill: #172B4D; -fx-font-size: 19px; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="140" spacing="8"
              style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: transparent #DCE4EE transparent transparent;">
            <Button text="Navigation" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#showNavigation"
                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-padding: 8 10;" />
            <Button text="Favorite places" alignment="CENTER_LEFT" maxWidth="Infinity"
                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-padding: 8 10;" />
            <Button text="Schedule" alignment="CENTER_LEFT" maxWidth="Infinity"
                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-padding: 8 10;" />
            <Button text="Friends" alignment="CENTER_LEFT" maxWidth="Infinity"
                    onAction="#backToFriends"
                    style="-fx-background-color: #3B6FC4; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 10;" />
        </VBox>
    </left>

    <center>
        <VBox style="-fx-padding: 14;">
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #DCE4EE; -fx-border-radius: 10; -fx-padding: 12;">
                <Label text="Add Friend"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #172B4D;" />
                <Label text="Username" style="-fx-text-fill: #334155;" />
                <TextField fx:id="usernameField" promptText="Enter username" />

                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Button text="Cancel" onAction="#backToFriends" />
                    <Button fx:id="sendButton" text="Send Request"
                            defaultButton="true" onAction="#sendRequest"
                            style="-fx-background-color: #3B6FC4; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 7 10;" />
                </HBox>

                <Label fx:id="messageLabel" visible="false" managed="false" wrapText="true" />
            </VBox>
        </VBox>
    </center>

</BorderPane>