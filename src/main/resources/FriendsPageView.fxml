<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="336.0" prefWidth="419.0" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FriendsController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="66.0" prefWidth="452.0" style="-fx-background-color: white; -fx-padding: 0 18 0 18; -fx-border-color: transparent transparent #DCE4EE transparent;">
            <children>
                <Label style="-fx-text-fill: #172B4D; -fx-font-size: 19px; -fx-font-weight: bold;" text="Bilkent PathFinder" />
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: white; -fx-padding: 0 18 0 18; -fx-border-color: transparent transparent #DCE4EE transparent;" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="140.0" spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: transparent #DCE4EE transparent transparent;">
            <children>
                <Button fx:id="navigationButton" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#showNavigation" style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-padding: 8 10 8 10;" text="Navigation" />

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-padding: 8 10 8 10;" text="Favorite places" />

                <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-padding: 8 10 8 10;" text="Schedule" />

                <Button fx:id="navigationButton" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#showNavigation" style="-fx-background-color: #3B6FC4; -fx-text-fill: #FFFFFF; -fx-background-radius: 6; -fx-padding: 8 10 8 10;" text="Friends" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #172B4D;" text="Friends" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="addFriendButton" onAction="#showAddFriend" style="-fx-background-color: #3B6FC4; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 7 10;" text="+ Add Friend" />
                    </children>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #DCE4EE; -fx-border-radius: 10; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                    <children>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-background-color: white; -fx-padding: 0;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="friendsList" spacing="8.0">
                                    <children>

                                        <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #F1F5F9; -fx-background-radius: 8; -fx-padding: 8;">
                                            <children>
                                                <Label style="-fx-text-fill: #172B4D; -fx-font-weight: bold;" text="Selin Yılmaz" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label style="-fx-background-color: #E2E8F0; -fx-text-fill: #475569; -fx-background-radius: 12; -fx-padding: 4 7; -fx-font-size: 11px;" text="Unavailable" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

</BorderPane>
