<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            prefWidth="600"
            prefHeight="500"
            style="-fx-background-color: #101B2D;">

    <children>
        <VBox alignment="CENTER"
              spacing="15"
              layoutX="100"
              layoutY="50"
              prefWidth="400"
              prefHeight="400">

            <Label text="BILKENT PATHFINDER"
                   style="-fx-text-fill: white;
                          -fx-font-size: 26px;
                          -fx-font-weight: bold;"/>

            <Label text="Welcome Back!"
                   style="-fx-text-fill: #9CACBF;
                          -fx-font-size: 16px;"/>

            <TextField fx:id="usernameField"
                       promptText="Username"
                       maxWidth="300"/>

            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           maxWidth="300"/>

            <Button fx:id="loginButton"
                    text="Log In"
                    prefWidth="300"
                    style="-fx-background-color: #3478E5;
                           -fx-text-fill: white;"/>

            <Button fx:id="registerButton"
                    text="Create an Account"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #75B8FF;"/>

        </VBox>
    </children>
</AnchorPane>