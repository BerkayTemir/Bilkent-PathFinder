<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.LoginController"
           prefWidth="1100"
           prefHeight="850"
           style="-fx-background-color: #0B1120;">

    <VBox alignment="CENTER_LEFT"
          maxWidth="525"
          maxHeight="650"
          spacing="17"
          style="-fx-background-color: #19253B;
                 -fx-background-radius: 20;">

        <padding>
            <Insets top="45" right="45"
                    bottom="45" left="45"/>
        </padding>

        <Label text="BILKENT PATHFINDER"
               style="-fx-text-fill: #60A5FA;
                      -fx-font-size: 16;
                      -fx-font-weight: bold;"/>

        <Label text="Welcome Back"
               style="-fx-text-fill: white;
                      -fx-font-size: 34;
                      -fx-font-weight: bold;"/>

        <Label text="Sign in to continue your journey."
               style="-fx-text-fill: #94A3B8;
                      -fx-font-size: 14;"/>

        <Region prefHeight="18"/>

        <Label text="Username"
               style="-fx-text-fill: white;
                      -fx-font-weight: bold;"/>

        <TextField fx:id="usernameField"
                   promptText="Enter your username"
                   prefHeight="55"
                   style="-fx-background-color: #29394F;
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #94A3B8;
                          -fx-background-radius: 10;"/>

        <Label text="Password"
               style="-fx-text-fill: white;
                      -fx-font-weight: bold;"/>

        <PasswordField fx:id="passwordField"
                       promptText="Enter your password"
                       prefHeight="55"
                       style="-fx-background-color: #29394F;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #94A3B8;
                              -fx-background-radius: 10;"/>

        <Hyperlink text="Forgot Password?"
                   onAction="#handleForgotPassword"
                   style="-fx-text-fill: #60A5FA;
                          -fx-font-size: 13;"/>

        <Button text="Login"
                onAction="#handleLogin"
                maxWidth="Infinity"
                prefHeight="55"
                style="-fx-background-color: #2563EB;
                       -fx-text-fill: white;
                       -fx-font-size: 17;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-cursor: hand;"/>

        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               style="-fx-text-fill: #F87171;
                      -fx-font-size: 13;"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?"
                   style="-fx-text-fill: #94A3B8;"/>

            <Hyperlink text="Create Account"
                       onAction="#handleCreateAccount"
                       style="-fx-text-fill: #60A5FA;
                              -fx-font-weight: bold;"/>
        </HBox>

    </VBox>
</StackPane>
