<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: #0B1120;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">

    <VBox alignment="CENTER_LEFT" maxHeight="685.0" maxWidth="600.0" minHeight="800.0" minWidth="1280.0" prefHeight="685.0" prefWidth="991.0" spacing="17" style="-fx-background-color: #19253B;                  -fx-background-radius: 20;" StackPane.alignment="CENTER">

        <padding>
            <Insets bottom="45" left="45" right="45" top="45" />
        </padding>

        <Label style="-fx-text-fill: #60A5FA;                       -fx-font-size: 16;                       -fx-font-weight: bold;" text="BILKENT PATHFINDER" />

        <Label style="-fx-text-fill: white;                       -fx-font-size: 34;                       -fx-font-weight: bold;" text="Welcome Back" />

        <Label style="-fx-text-fill: #94A3B8;                       -fx-font-size: 14;" text="Sign in to continue your journey." />

        <Region prefHeight="18" />

        <Label style="-fx-text-fill: white;                       -fx-font-weight: bold;" text="Username" />

        <TextField fx:id="usernameField" prefHeight="55" promptText="Enter your username" style="-fx-background-color: #29394F;                           -fx-text-fill: white;                           -fx-prompt-text-fill: #94A3B8;                           -fx-background-radius: 10;" />

        <Label style="-fx-text-fill: white;                       -fx-font-weight: bold;" text="Password" />

        <PasswordField fx:id="passwordField" prefHeight="55" promptText="Enter your password" style="-fx-background-color: #29394F;                               -fx-text-fill: white;                               -fx-prompt-text-fill: #94A3B8;                               -fx-background-radius: 10;" />

        <Hyperlink onAction="#handleForgotPassword" style="-fx-text-fill: #60A5FA;                           -fx-font-size: 13;" text="Forgot Password?" />

        <Button maxWidth="Infinity" onAction="#handleLogin" prefHeight="55" style="-fx-background-color: #2563EB;                        -fx-text-fill: white;                        -fx-font-size: 17;                        -fx-font-weight: bold;                        -fx-background-radius: 10;                        -fx-cursor: hand;" text="Login" />

        <Label fx:id="messageLabel" style="-fx-text-fill: #F87171;                       -fx-font-size: 13;" text="" wrapText="true" />

        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #94A3B8;" text="Don't have an account?" />

            <Hyperlink onAction="#handleCreateAccount" style="-fx-text-fill: #60A5FA;                               -fx-font-weight: bold;" text="Create Account" />
        </HBox>

    </VBox>
</StackPane>
