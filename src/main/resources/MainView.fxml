<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane prefHeight="336.0" prefWidth="419.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Bilkent PathFinder" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="navigationButton" mnemonicParsing="false" onAction="#handleNavigation" text="Navigation" />
            <Button mnemonicParsing="false" text="Favorite places" />
            <Button mnemonicParsing="false" text="Schedule" />
            <Button mnemonicParsing="false" text="Friends" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="mapContainer" prefHeight="314.0" prefWidth="319.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
