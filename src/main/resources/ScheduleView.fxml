<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="480.0" prefWidth="650.0" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ScheduleController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="66.0" prefWidth="452.0" style="-fx-background-color: white; -fx-padding: 0 18 0 18;                      -fx-border-color: transparent transparent #DCE4EE transparent;">
            <children>
                <Label style="-fx-text-fill: #172B4D; -fx-font-size: 19px;                               -fx-font-weight: bold;" text="Bilkent PathFinder" />
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: white; -fx-padding: 0 18 0 18;                      -fx-border-color: transparent transparent #DCE4EE transparent;" />
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="140.0" spacing="8.0" style="-fx-background-color: white; -fx-padding: 12;                      -fx-border-color: transparent #DCE4EE transparent transparent;">
            <children>
                <Button fx:id="navigationButton" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#showNavigation" style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155; -fx-background-radius: 6; -fx-padding: 8 10 8 10;" text="Navigation" />

                                                                      <Button alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155;                                -fx-background-radius: 6; -fx-padding: 8 10 8 10;" text="Favorite places" />

                                                                      <Button fx:id="scheduleButton" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#showSchedule" style="-fx-background-color: #3B6FC4; -fx-text-fill: #FFFFFF; -fx-background-radius: 6; -fx-padding: 8 10 8 10;" text="Schedule" />

                                                                      <Button fx:id="friendsButton" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#showFriends" style="-fx-background-color: #F1F5F9; -fx-text-fill: #334155;                                -fx-background-radius: 6; -fx-padding: 8 10 8 10;" text="Friends" />
            </children>
        </VBox>
    </left>

    <center>
        <StackPane style="-fx-padding: 14;">
            <children>
                <StackPane fx:id="mapContainer" style="-fx-background-color: white; -fx-background-radius: 10;                                   -fx-border-color: #DCE4EE; -fx-border-radius: 10;">
               <children>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                     <content>
                        <VBox prefWidth="500.0" spacing="10.0">
                           <padding>
                              <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                           </padding>
                           <children>
                              <Label text="My Schedule" />
                              <Label text="Current Status" />
                              <Label fx:id="statusLabel" text="Available" />
                              <Label text="Next Class" />
                              <Label fx:id="nextClassLabel" text="No Upcoming Class" />
                              <Label fx:id="remainingTimeLabel" text="0 minutes left" />
                              <Label text="Today's Schedule" />
                              <ListView fx:id="courseListView" maxHeight="-Infinity" minHeight="52.0" prefHeight="150.0" prefWidth="454.0" />
                              <Button fx:id="addCourseButton" mnemonicParsing="false" onAction="#addCourse" text="Add Course" />
                              <Button fx:id="removeCourseButton" mnemonicParsing="false" onAction="#removeCourse" text="Remove Course" />
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
                </StackPane>
            </children>
        </StackPane>
    </center>

</BorderPane>
