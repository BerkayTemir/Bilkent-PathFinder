<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700" prefWidth="900" style="-fx-background-color: #0B1120;" stylesheets="@signup.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="controller.SignUpController">

    <VBox alignment="CENTER_LEFT" maxHeight="650" maxWidth="420" prefHeight="392.0" prefWidth="420.0" spacing="14" style="-fx-background-color: #172338;                  -fx-background-radius: 18;                  -fx-padding: 35;">

        <Label style="-fx-text-fill: #60A5FA;                       -fx-font-weight: bold;                       -fx-font-size: 13;" text="BILKENT PATHFINDER" />

        <Label style="-fx-text-fill: white;                       -fx-font-size: 28;                       -fx-font-weight: bold;" text="Create Account" />

        <Label style="-fx-text-fill: #94A3B8;                       -fx-font-size: 13;" text="Create your account to get started." />

        <Region prefHeight="12" />

        <VBox spacing="7">
            <Label styleClass="field-label" text="Username" />
            <TextField fx:id="usernameField" promptText="Choose a username" styleClass="form-field" />
        </VBox>

        <HBox spacing="12">

            <VBox spacing="7" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="First Name" />
                <TextField fx:id="nameField" maxWidth="Infinity" promptText="First name" styleClass="form-field" />
            </VBox>

            <VBox spacing="7" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Last Name" />
                <TextField fx:id="surnameField" maxWidth="Infinity" promptText="Last name" styleClass="form-field" />
            </VBox>

        </HBox>

        <VBox spacing="7">
            <Label styleClass="field-label" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Enter password" styleClass="form-field" />
        </VBox>

        <VBox spacing="7">
            <Label styleClass="field-label" text="Confirm Password" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" styleClass="form-field" />
        </VBox>

        <Region prefHeight="8" />

        <Button maxWidth="Infinity" onAction="#handleSignup" styleClass="signup-button" text="Create Account" />

        <Label fx:id="messageLabel" style="-fx-text-fill: #FCA5A5;" wrapText="true" />

    </VBox>

</StackPane>
